# Copy to server/.env and fill in. Never commit the real .env.

# Postgres
POSTGRES_PASSWORD=change-me

# n8n basic auth (UI login)
N8N_HOST=agapornis.example.com
N8N_USER=admin
N8N_PASSWORD=change-me

# MercadoLibre OAuth app (developers.mercadolibre.com)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=

# Buy-plan budget for the worker demo (cents). Optional.
BUDGET_CENTS=30000

# Finance ingest API
INGEST_TOKEN=change-me-long-random
INOUT_USER_ID=00000000-0000-0000-0000-000000000001

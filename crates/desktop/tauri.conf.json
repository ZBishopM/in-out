{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "in_out",
  "version": "0.1.0",
  "identifier": "com.agapornis.inout",
  "build": {
    "frontendDist": "../../apps/ui/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../../apps/ui dev",
    "beforeBuildCommand": "pnpm --dir ../../apps/ui build"
  },
  "app": {
    "windows": [
      {
        "title": "in_out",
        "width": 1100,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
